# ==============================================================================
# Cadence Genus Synthesis Script
# Design: 2x2 MIMO Baseband Processor (mimo_baseband_top)
# Target Process: SCL 180nm / Cadence gpdk180 Standard Cell Library
# Core Voltage: 1.8V | Target Clock: 100 MHz (10.0 ns)
# ==============================================================================

set_db / .init_ground_nets {VSS GND}
set_db / .init_power_nets  {VDD}

# Enable multithreading for acceleration
set_multi_cpu_usage -local_cpu 8

# Setup directory variables
set DESIGN_NAME       "mimo_baseband_top"
set SCRIPT_DIR        [file dirname [info script]]
set ASIC_ROOT         [file normalize "${SCRIPT_DIR}/../.."]
set SDC_FILE          "${SCRIPT_DIR}/../sdc/mimo_baseband_100mhz.sdc"
set REPORT_DIR        "${SCRIPT_DIR}/../reports/genus"
set OUTPUT_DIR        "${SCRIPT_DIR}/../outputs/genus"

# Create output directories if not present
file mkdir $REPORT_DIR
file mkdir $OUTPUT_DIR

puts "======================================================================"
puts " STEP 1: LIBRARY SETUP & PHYSICAL LAYOUT ESTIMATION (PLE)             "
puts "======================================================================"

# Standard Cell Timing Libraries (.lib)
# For setup analysis, use Worst-Case (Slow) corner: SS_1.62V_125C
# For hold analysis, use Best-Case (Fast) corner: FF_1.98V_-40C
set LIB_DIR "/cadence/pdk/gpdk180/lib" ; # Modify according to lab environment
set_db / .target_library [list \
    "${LIB_DIR}/slow_vdd1v8_125c.lib" \
]
set_db / .link_library [list \
    "*" \
    "${LIB_DIR}/slow_vdd1v8_125c.lib" \
    "${LIB_DIR}/typical_vdd1v8_25c.lib" \
    "${LIB_DIR}/fast_vdd1v8_m40c.lib" \
]

# Physical LEF files for PLE (Physical Layout Estimation)
set LEF_DIR "/cadence/pdk/gpdk180/lef"
set_db / .lef_library [list \
    "${LEF_DIR}/gpdk180_tech.lef" \
    "${LEF_DIR}/gpdk180_stdcells.lef" \
]

# Set operating conditions (Worst Case for setup timing closure)
set_db / .operating_conditions slow_vdd1v8_125c

puts "======================================================================"
puts " STEP 2: READ RTL SOURCE FILES (HDL CODER GENERATED VERILOG)          "
puts "======================================================================"

# RTL files generated by MATLAB HDL Coder and top-level integration
set VERILOG_LIST [list \
    "${ASIC_ROOT}/build_rtl/nfp_uminus_single.v" \
    "${ASIC_ROOT}/build_rtl/nfp_gain_pow2_single.v" \
    "${ASIC_ROOT}/build_rtl/nfp_relop_single.v" \
    "${ASIC_ROOT}/build_rtl/nfp_relop_single_block.v" \
    "${ASIC_ROOT}/build_rtl/nfp_relop_single_block1.v" \
    "${ASIC_ROOT}/build_rtl/nfp_relop_single_block2.v" \
    "${ASIC_ROOT}/build_rtl/nfp_add_single.v" \
    "${ASIC_ROOT}/build_rtl/nfp_sub_single.v" \
    "${ASIC_ROOT}/build_rtl/nfp_mul_single.v" \
    "${ASIC_ROOT}/build_rtl/nfp_div_single.v" \
    "${ASIC_ROOT}/build_rtl/nfp_recip_single.v" \
    "${ASIC_ROOT}/build_rtl/adaptive_controller_hw.v" \
    "${ASIC_ROOT}/build_rtl/alamouti_encoder_hw.v" \
    "${ASIC_ROOT}/build_rtl/alamouti_combiner_hw.v" \
    "${ASIC_ROOT}/build_rtl/water_filling_hw.v" \
    "${ASIC_ROOT}/build_rtl/qam_slicer_hw.v" \
    "${ASIC_ROOT}/build_rtl/mmse_sic_hw.v" \
    "${ASIC_ROOT}/01_interfaces_and_bus/mimo_axi4_lite_slave.v" \
    "${ASIC_ROOT}/01_interfaces_and_bus/mimo_axis_stream_adapter.v" \
    "${ASIC_ROOT}/01_interfaces_and_bus/mimo_interconnect_crossbar.v" \
    "${ASIC_ROOT}/06_top_integration/mimo_baseband_top.v" \
]

# Check and read RTL files
foreach f $VERILOG_LIST {
    if {[file exists $f]} {
        read_hdl -language v2001 $f
    } else {
        puts "WARNING: File $f not found. Will use mock/elaboration template."
    }
}

puts "======================================================================"
puts " STEP 3: ELABORATE & RESOLVE HIERARCHY                                "
puts "======================================================================"

elaborate $DESIGN_NAME
current_design $DESIGN_NAME

# Verify unmapped pins or unresolved blackboxes
check_design -unresolved > ${REPORT_DIR}/genus_unresolved_pins.rpt

puts "======================================================================"
puts " STEP 4: APPLY SDC TIMING CONSTRAINTS & AUDIT                         "
puts "======================================================================"

read_sdc $SDC_FILE

# Lint constraints to identify missing clocks, unconstrained ports, or loops
check_timing_intent -verbose > ${REPORT_DIR}/genus_timing_lint.rpt

puts "======================================================================"
puts " STEP 5: LOGIC SYNTHESIS (GENERIC -> MAPPING -> SPATIAL/PLE OPT)      "
puts "======================================================================"

# Synthesis effort settings
set_db / .syn_generic_effort high
set_db / .syn_map_effort     high
set_db / .syn_opt_effort     high

# Configure datapath / CORDIC arithmetic optimizations
set_db / .dp_effort high
set_db / .auto_ungroup none ; # Preserve modular sub-blocks for LEC & debug

# 5a. Generic Synthesis
puts "--- Running syn_generic ---"
syn_generic

# 5b. Technology Mapping to 180nm Standard Cells
puts "--- Running syn_map ---"
syn_map

# 5c. Optimization with Physical Layout Estimation (wire parasitics from LEF)
puts "--- Running syn_opt ---"
syn_opt

puts "======================================================================"
puts " STEP 6: GENERATE COMPREHENSIVE QOR REPORTS                           "
puts "======================================================================"

report_timing -max_paths 50 > ${REPORT_DIR}/genus_timing_setup_worst50.rpt
report_timing -min_paths 20 > ${REPORT_DIR}/genus_timing_hold_worst20.rpt
report_area   -detail       > ${REPORT_DIR}/genus_area_breakdown.rpt
report_power  -hierarchy    > ${REPORT_DIR}/genus_power_breakdown.rpt
report_gates                > ${REPORT_DIR}/genus_gate_count.rpt
report_qor                  > ${REPORT_DIR}/genus_qor_summary.rpt

puts "======================================================================"
puts " STEP 7: EXPORT GATE-LEVEL NETLIST, SDC, AND LEC DOFILES              "
puts "======================================================================"

# Write out synthesized Verilog netlist for Innovus P&R and Conformal LEC
write_hdl -mapped > ${OUTPUT_DIR}/${DESIGN_NAME}_synth.v

# Write out updated constraints for physical design
write_sdc > ${OUTPUT_DIR}/${DESIGN_NAME}_synth.sdc

# Export Conformal Logic Equivalence Checking (LEC) environment
write_do_lec -golden_design $DESIGN_NAME \
             -revised_design ${OUTPUT_DIR}/${DESIGN_NAME}_synth.v \
             -logfile ${REPORT_DIR}/genus_to_lec.log \
             > ${OUTPUT_DIR}/run_conformal_lec_auto.do

puts "======================================================================"
puts " GENUS SYNTHESIS COMPLETED SUCCESSFULLY                               "
puts " Output Gate Netlist: ${OUTPUT_DIR}/${DESIGN_NAME}_synth.v           "
puts " Output SDC:          ${OUTPUT_DIR}/${DESIGN_NAME}_synth.sdc          "
puts "======================================================================"
